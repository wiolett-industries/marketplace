{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@wiolett/oai-auth": ["../oai-auth/src/index.ts"]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.js"
  ]
}
