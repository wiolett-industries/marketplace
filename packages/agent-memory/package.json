{
  "name": "@wiolett/agent-memory",
  "version": "0.2.3",
  "type": "module",
  "description": "MCP server backing Agent Memory with scoped storage, model-gated writes, compiled recall, and automatic graph links.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-memory": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./init": "./dist/init.js",
    "./register": "./dist/register.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiolett-industries/marketplace.git",
    "directory": "packages/agent-memory"
  },
  "homepage": "https://github.com/wiolett-industries/marketplace/tree/main/packages/agent-memory",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "start": "NODE_NO_WARNINGS=1 node dist/index.js",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "nanoid": "^5.1.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "jest": "^30.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
