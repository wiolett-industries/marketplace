{
  "name": "@wiolett/agent-memory",
  "version": "0.4.2",
  "type": "module",
  "description": "MCP server backing Agent Memory with scoped storage, model-gated writes, compiled recall, and automatic graph links.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-memory": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./init": "./dist/init.js",
    "./register": "./dist/register.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiolett-industries/marketplace.git",
    "directory": "packages/agent-memory"
  },
  "homepage": "https://github.com/wiolett-industries/marketplace/tree/main/packages/agent-memory",
  "scripts": {
    "clean": "rm -rf dist",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "pnpm run clean && pnpm run build:ui && tsc -p tsconfig.build.json",
    "dev": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "start": "NODE_NO_WARNINGS=1 node dist/index.js",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "nanoid": "^5.1.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "@fontsource/saira-condensed": "^5.1.1",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "d3-force-3d": "^3.0.6",
    "jest": "^30.2.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.27.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
