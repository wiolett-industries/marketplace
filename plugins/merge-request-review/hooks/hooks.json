{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^merge_request_",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/merge-request-review-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Applying MR reviewer contract"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^merge_request_",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/merge-request-review-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking MR reviewer output"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/merge-request-review-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking MR review handoff"
          }
        ]
      }
    ]
  }
}
