{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Loading workflow context"
          }
        ]
      }
    ]
  }
}
