{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/workflow-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Loading workflow context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/workflow-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Completing workflow compact hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(workflow_|merge_request_)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/workflow-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Applying workflow agent contract"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(workflow_|merge_request_)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/workflow-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking workflow agent output"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/workflow-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking plan commitment"
          }
        ]
      }
    ]
  }
}
